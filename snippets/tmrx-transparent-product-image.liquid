{% if transparent_image_file != blank %}
  <img
    src="{{ transparent_image_file | asset_url }}"
    alt="{{ render_alt | escape }}"
    width="{{ render_width }}"
    height="{{ render_height }}"
    loading="{{ render_loading }}"
    {% if render_class != blank %}class="{{ render_class }}"{% endif %}
    {% if fetchpriority != blank %}fetchpriority="{{ fetchpriority }}"{% endif %}
  >
{% elsif image != blank %}
  <img
    src="{{ image | image_url: width: 1200 }}"
    alt="{{ render_alt | escape }}"
    width="{{ render_width }}"
    height="{{ render_height }}"
    loading="{{ render_loading }}"
    {% if render_class != blank %}class="{{ render_class }}"{% endif %}
    {% if fetchpriority != blank %}fetchpriority="{{ fetchpriority }}"{% endif %}
  >
{% endif %}
