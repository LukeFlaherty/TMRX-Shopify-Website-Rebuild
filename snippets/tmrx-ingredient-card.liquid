<article class="tmrx-pdp-ingredient-card">
  <button type="button" aria-label="More about {{ title | escape }}">
    <span aria-hidden="true">+</span>
  </button>
  <h3>{{ title }}</h3>
  {% if amount != blank %}
    <p class="tmrx-pdp-ingredient-card__amount">{{ amount }}</p>
  {% endif %}
  <p>{{ body }}</p>
</article>
