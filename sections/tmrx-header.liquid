<header class="tmrx-header" data-site-header>
  {% if section.settings.announcement_text != blank %}
    <div class="tmrx-announcement">
      <a
        class="tmrx-announcement__link"
        href="{{ section.settings.announcement_link | default: routes.all_products_collection_url }}"
      >
        {{ section.settings.announcement_text }}
      </a>
    </div>
  {% endif %}

  <div class="tmrx-header__bar">
    <button class="tmrx-icon-button tmrx-header__menu-button" type="button" data-menu-toggle aria-expanded="false" aria-controls="TMRXMobileMenu">
      <span class="visually-hidden">Open menu</span>
      <svg aria-hidden="true" viewBox="0 0 24 24">
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
    </button>

    <a class="tmrx-header__brand" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
      {{ section.settings.brand_text | default: shop.name }}
    </a>

    <nav class="tmrx-header__nav" aria-label="Primary navigation">
      <div class="tmrx-nav-item">
        <a href="{{ routes.all_products_collection_url }}?tmrx_category=bestsellers">Bestsellers</a>
        {% render 'tmrx-mega-bestsellers',
          title: 'Bestsellers',
          collection_handle: 'bestsellers',
          fallback_url: '/collections/all?tmrx_category=bestsellers'
        %}
      </div>
      <div class="tmrx-nav-item">
        <a href="{{ routes.all_products_collection_url }}?tmrx_category=recovery">Recovery</a>
        {% render 'tmrx-mega-products',
          title: 'Recovery',
          collection_handle: 'recovery',
          fallback_url: '/collections/all?tmrx_category=recovery',
          highlight_title: 'Recovery Highlight',
          highlight_text: 'Support training output with formulas built for strength and recovery.'
        %}
      </div>
      <div class="tmrx-nav-item">
        <a href="{{ routes.all_products_collection_url }}?tmrx_category=pre-workout">Improve Performance</a>
        {% render 'tmrx-mega-products',
          title: 'Improve Performance',
          collection_handle: 'pre-workout',
          fallback_url: '/collections/all?tmrx_category=pre-workout',
          highlight_title: 'Performance Highlight',
          highlight_text: 'Shop formulas that support energy, strength, focus, and endurance.'
        %}
      </div>
      <div class="tmrx-nav-item">
        <a href="{{ routes.all_products_collection_url }}?tmrx_category=wellness">Health & Wellness</a>
        {% render 'tmrx-mega-products',
          title: 'Health & Wellness',
          collection_handle: 'wellness',
          fallback_url: '/collections/all?tmrx_category=wellness',
          highlight_title: 'Wellness Highlight',
          highlight_text: 'Foundational support for hormone, liver, cellular, and daily health.'
        %}
      </div>
    </nav>

    <div class="tmrx-header__actions" aria-label="Store actions">
      <a class="tmrx-icon-button" href="{{ routes.search_url }}" aria-label="Search">
        <svg aria-hidden="true" viewBox="0 0 24 24">
          <path d="m21 21-4.3-4.3M10.8 18a7.2 7.2 0 1 1 0-14.4 7.2 7.2 0 0 1 0 14.4Z" />
        </svg>
      </a>
      <a class="tmrx-icon-button tmrx-header__account" href="{{ routes.account_login_url }}" aria-label="Account">
        <svg aria-hidden="true" viewBox="0 0 24 24">
          <path d="M20 21a8 8 0 0 0-16 0M12 13a5 5 0 1 0 0-10 5 5 0 0 0 0 10Z" />
        </svg>
      </a>
      <button class="tmrx-icon-button tmrx-cart-button" type="button" data-cart-open aria-label="Open cart">
        <svg aria-hidden="true" viewBox="0 0 24 24">
          <path d="M6 7h15l-1.8 9.2a2 2 0 0 1-2 1.6H8.7a2 2 0 0 1-2-1.7L5.2 4H2" />
          <path d="M9 21h.01M18 21h.01" />
        </svg>
        <span class="tmrx-cart-button__count" aria-label="{{ cart.item_count }} cart items">{{ cart.item_count }}</span>
      </button>
    </div>
  </div>

  <div class="tmrx-mobile-menu" id="TMRXMobileMenu" data-mobile-menu hidden>
    <div class="tmrx-mobile-menu__panel">
      <div class="tmrx-mobile-menu__top">
        <span>{{ section.settings.brand_text | default: shop.name }}</span>
        <div class="tmrx-mobile-menu__actions" aria-label="Store actions">
          <a class="tmrx-icon-button" href="{{ routes.search_url }}" aria-label="Search">
            <svg aria-hidden="true" viewBox="0 0 24 24">
              <path d="m21 21-4.3-4.3M10.8 18a7.2 7.2 0 1 1 0-14.4 7.2 7.2 0 0 1 0 14.4Z" />
            </svg>
          </a>
          <a class="tmrx-icon-button" href="{{ routes.account_login_url }}" aria-label="Account">
            <svg aria-hidden="true" viewBox="0 0 24 24">
              <path d="M20 21a8 8 0 0 0-16 0M12 13a5 5 0 1 0 0-10 5 5 0 0 0 0 10Z" />
            </svg>
          </a>
          <button class="tmrx-icon-button tmrx-cart-button" type="button" data-cart-open aria-label="Open cart">
            <svg aria-hidden="true" viewBox="0 0 24 24">
              <path d="M6 7h15l-1.8 9.2a2 2 0 0 1-2 1.6H8.7a2 2 0 0 1-2-1.7L5.2 4H2" />
              <path d="M9 21h.01M18 21h.01" />
            </svg>
            <span class="tmrx-cart-button__count" aria-label="{{ cart.item_count }} cart items">{{ cart.item_count }}</span>
          </button>
        </div>
        <button class="tmrx-icon-button" type="button" data-menu-close aria-label="Close menu">
          <svg aria-hidden="true" viewBox="0 0 24 24">
            <path d="M18 6 6 18M6 6l12 12" />
          </svg>
        </button>
      </div>
      <nav class="tmrx-mobile-menu__nav" aria-label="Mobile navigation">
        <a class="tmrx-mobile-menu__shop-all" href="{{ routes.all_products_collection_url }}">
          Shop All
          <img src="{{ 'icon-arrow-right.svg' | asset_url }}" alt="" width="18" height="18" aria-hidden="true" loading="lazy">
        </a>
        {% render 'tmrx-mobile-menu-group',
          title: 'Bestsellers',
          collection_handle: 'bestsellers',
          fallback_url: '/collections/all?tmrx_category=bestsellers',
          open: false
        %}
        {% render 'tmrx-mobile-menu-group',
          title: 'Protein',
          collection_handle: 'protein',
          fallback_url: '/collections/all?tmrx_category=protein',
          open: false
        %}
        {% render 'tmrx-mobile-menu-group',
          title: 'Build Muscle & Recover',
          collection_handle: 'recovery',
          fallback_url: '/collections/all?tmrx_category=recovery',
          open: false
        %}
        {% render 'tmrx-mobile-menu-group',
          title: 'Pre-Workout',
          collection_handle: 'pre-workout',
          fallback_url: '/collections/all?tmrx_category=pre-workout',
          open: false
        %}
        {% render 'tmrx-mobile-menu-group',
          title: 'Health & Wellness',
          collection_handle: 'wellness',
          fallback_url: '/collections/all?tmrx_category=wellness',
          open: false
        %}
        {% render 'tmrx-mobile-menu-group',
          title: 'Weight Loss',
          collection_handle: 'weight-loss',
          fallback_url: '/collections/all?tmrx_category=weight-loss',
          open: false
        %}
        {% render 'tmrx-mobile-menu-group',
          title: 'Improve Performance',
          collection_handle: 'pre-workout',
          fallback_url: '/collections/all?tmrx_category=pre-workout',
          open: false
        %}
      </nav>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "TMRX header",
  "settings": [
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement text",
      "default": "Free shipping on orders over $50"
    },
    {
      "type": "url",
      "id": "announcement_link",
      "label": "Announcement link"
    },
    {
      "type": "text",
      "id": "brand_text",
      "label": "Brand text",
      "default": "TMRX"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu"
    }
  ]
}
{% endschema %}
