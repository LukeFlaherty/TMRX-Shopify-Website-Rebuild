          Staged pagination: these controls are intentionally disabled until real review pagination is connected.
        {% endcomment %}
        <button type="button" disabled aria-disabled="true">Previous</button>
        <button type="button" class="is-active" disabled aria-disabled="true" aria-current="page">1</button>
        <button type="button" disabled aria-disabled="true">2</button>
        <button type="button" disabled aria-disabled="true">3</button>
        <button type="button" disabled aria-disabled="true">Next</button>
      </nav>
    </div>
  </div>

  <div class="tmrx-review-modal" data-review-modal hidden>
    <div class="tmrx-review-modal__overlay" data-review-close></div>
    <div class="tmrx-review-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="tmrx-review-title-{{ section.id }}">
      <button class="tmrx-review-modal__close" type="button" aria-label="Close review form" data-review-close>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
      </button>

      {% form 'contact', id: review_form_id, class: 'tmrx-review-form', data-review-form: '' %}
        <input type="hidden" name="return_to" value="{{ product.url }}#tmrx-pdp-reviews">
        <input type="hidden" name="contact[Product]" value="{{ product.title }}">
        <input type="hidden" name="contact[Product Handle]" value="{{ product.handle }}">
        <input type="hidden" name="contact[Product URL]" value="{{ shop.url }}{{ product.url }}">
        <input type="hidden" name="contact[Review Rating]" value="5" data-review-rating-field>

        {% if form.posted_successfully? %}
          <div class="tmrx-review-form__success" role="status">
            <h2>Thanks for your review.</h2>
            <p>We received it and will review it before publishing.</p>
          </div>
        {% else %}
          {% if form.errors %}
            <div class="tmrx-review-form__errors" role="alert">{{ form.errors | default_errors }}</div>
          {% endif %}

          <div class="tmrx-review-form__step is-active" data-review-step="rating">
            <h2 id="tmrx-review-title-{{ section.id }}">How would you rate this product?</h2>
            <p>We would love it if you would share a bit about your experience.</p>
            <div class="tmrx-review-form__product">
              <div class="tmrx-review-form__image{% if product.featured_image == blank %} tmrx-placeholder-media{% endif %}">
                {% if product.featured_image %}
                  {% render 'tmrx-transparent-product-image', image: product.featured_image, width: 360, loading: 'lazy', alt: product.title %}
                {% endif %}
              </div>
              <strong>{{ product.title }}</strong>
            </div>
            <div class="tmrx-review-form__stars" role="radiogroup" aria-label="Rating">
              {% for rating in (1..5) %}
                <button class="is-selected" type="button" aria-label="{{ rating }} out of 5 stars" aria-pressed="true" data-review-rating="{{ rating }}">★</button>
              {% endfor %}
            </div>
            <div class="tmrx-review-form__scale" aria-hidden="true">
              <span>Poor</span>
              <span>Great</span>
            </div>
            <button class="tmrx-review-form__next" type="button" data-review-next>Next</button>
          </div>

          <div class="tmrx-review-form__step" data-review-step="details">
            <h2>{{ product.title }}</h2>
            <div class="tmrx-review-form__stars tmrx-review-form__stars--small" aria-hidden="true" data-review-selected-stars>
              <span>★★★★★</span>
            </div>
            <label for="ReviewBody-{{ section.id }}">Review* (Required)</label>
            <textarea id="ReviewBody-{{ section.id }}" name="contact[body]" placeholder="Start writing here..." required></textarea>
            <label for="ReviewTitle-{{ section.id }}">Review Title</label>
            <input id="ReviewTitle-{{ section.id }}" type="text" name="contact[Review Title]" placeholder="Give your review a title">
            <div class="tmrx-review-form__customer">
              <div>
                <label for="ReviewName-{{ section.id }}">Name</label>
                <input id="ReviewName-{{ section.id }}" type="text" name="contact[name]" autocomplete="name" placeholder="Your name">
              </div>
              <div>
                <label for="ReviewEmail-{{ section.id }}">Email* (Required)</label>
                <input id="ReviewEmail-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" placeholder="you@example.com" required>
              </div>
            </div>
            <p class="tmrx-review-form__legal">
              We'll only contact you about your review if necessary. By submitting your review, you agree to our
              <a href="{% if shop.terms_of_service.url != blank %}{{ shop.terms_of_service.url }}{% else %}/policies/terms-of-service{% endif %}">terms and conditions</a>
              and
              <a href="{% if shop.privacy_policy.url != blank %}{{ shop.privacy_policy.url }}{% else %}/policies/privacy-policy{% endif %}">privacy policy</a>.
            </p>
            <div class="tmrx-review-form__actions">
              <button type="button" data-review-back>Back</button>
              <button type="submit">Submit Review</button>
            </div>
          </div>
        {% endif %}
      {% endform %}
    </div>
  </div>

  <div class="tmrx-pdp-faq">
    <div class="tmrx-pdp-faq__inner">
      <h2>Frequently Asked Questions</h2>

      <div class="tmrx-pdp-faq__grid" aria-label="Product FAQs">
        <article class="tmrx-pdp-faq__card">
          <h3>{{ faq_1_question }}</h3>
          <p>{{ faq_1_answer }}</p>
        </article>
        <article class="tmrx-pdp-faq__card">
          <h3>{{ faq_2_question }}</h3>
          <p>{{ faq_2_answer }}</p>
        </article>
        <article class="tmrx-pdp-faq__card">
          <h3>{{ faq_3_question }}</h3>
          <p>{{ faq_3_answer }}</p>
        </article>
        <article class="tmrx-pdp-faq__card">
          <h3>{{ faq_4_question }}</h3>
          <p>{{ faq_4_answer }}</p>
        </article>
        <article class="tmrx-pdp-faq__card">
          <h3>{{ faq_5_question }}</h3>
          <p>{{ faq_5_answer }}</p>
        </article>
        <article class="tmrx-pdp-faq__card">
          <h3>{{ faq_6_question }}</h3>
          <p>{{ faq_6_answer }}</p>
        </article>
      </div>

      <div class="tmrx-pdp-faq__accordion" aria-label="Product FAQs">
        <details open>
          <summary>{{ faq_1_question }}</summary>
          <p>{{ faq_1_answer }}</p>
        </details>
        <details>
          <summary>{{ faq_2_question }}</summary>
          <p>{{ faq_2_answer }}</p>
        </details>
        <details>
          <summary>{{ faq_3_question }}</summary>
          <p>{{ faq_3_answer }}</p>
        </details>
        <details>
          <summary>{{ faq_4_question }}</summary>
          <p>{{ faq_4_answer }}</p>
        </details>
        <details>
          <summary>{{ faq_5_question }}</summary>
          <p>{{ faq_5_answer }}</p>
        </details>
        <details>
          <summary>{{ faq_6_question }}</summary>
          <p>{{ faq_6_answer }}</p>
        </details>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product",
  "settings": [
    {
      "type": "text",
      "id": "badge_label",
      "label": "Image badge",
      "default": "Best Seller"
    },
    {
      "type": "textarea",
      "id": "default_summary",
      "label": "Fallback hero summary",
      "default": "[product] is a clean, practitioner-grade supplement designed to support focused daily routines, performance, and long-term wellness."
    },
    {
      "type": "text",
      "id": "benefit_one",
      "label": "Benefit 1",
      "default": "Clean, purpose-built ingredients"
    },
    {
      "type": "text",
      "id": "benefit_two",
      "label": "Benefit 2",
      "default": "No unnecessary fillers, colors, or artificial additives"
    },
    {
      "type": "text",
      "id": "benefit_three",
      "label": "Benefit 3",
      "default": "Transparent formulas for daily optimization"
    },
    {
      "type": "text",
      "id": "doctor_heading",
      "label": "Doctor card heading",
      "default": "Doctor Recommended"
    },
    {
      "type": "textarea",
      "id": "doctor_body",
      "label": "Doctor card copy",
      "default": "[product] fits TRUE MATRx practitioner-grade standards: clean inputs, purposeful formulation, and support designed for health-focused routines."
    },
    {
      "type": "textarea",
      "id": "facts_copy",
      "label": "Fallback facts copy",
      "default": "Review the product label and Supplement Facts panel on your bottle for serving size, ingredients, and usage guidance. Consult your healthcare provider before starting any new supplement routine."
    },
    {
      "type": "textarea",
      "id": "shipping_copy",
      "label": "Fallback shipping and returns copy",
      "default": "Orders ship from TRUE MATRx as quickly as possible. If something is not right, contact support and we will help make it right."
    },
    {
      "type": "text",
      "id": "why_heading",
      "label": "Why section heading",
      "default": "Why Use [product]"
    },
    {
      "type": "textarea",
      "id": "why_intro",
      "label": "Why section intro",
      "default": "Whether you want to train harder, recover better, or support a cleaner daily routine, [product] can help."
    },
    {
      "type": "text",
      "id": "ingredients_heading",
      "label": "Ingredients section heading",
      "default": "Key Ingredients"
    },
    {
      "type": "textarea",
      "id": "ingredients_intro",
      "label": "Ingredients section intro",
      "default": "Our formulas are made with clean, purposeful ingredients selected to support health and performance."
    },
    {
      "type": "text",
      "id": "how_heading",
      "label": "How to use heading",
      "default": "How To Use"
    },
    {
      "type": "textarea",
      "id": "how_step_1_body",
      "label": "How to use step 1 copy",
      "default": "Add one level scoop of [product] into a shaker cup with 10-12 ounces of cold water or your preferred beverage. Adjust liquid to taste."
    },
    {
      "type": "textarea",
      "id": "how_step_2_body",
      "label": "How to use step 2 copy",
      "default": "Place the lid securely on your shaker cup and shake vigorously until the powder fully dissolves and the mix is smooth."
    },
    {
      "type": "textarea",
      "id": "how_step_3_body",
      "label": "How to use step 3 copy",
      "default": "For best results, consume [product] as directed on the label, ideally around your workout or as part of your daily routine."
    },
    {
      "type": "textarea",
      "id": "how_step_4_body",
      "label": "How to use step 4 copy",
      "default": "Use daily for consistent support. On rest days, take one serving in the morning, with or without food, unless your label says otherwise."
    }
  ]
}
{% endschema %}
