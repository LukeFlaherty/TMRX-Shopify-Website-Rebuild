{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'tmrx-product-form-' | append: section.id
  assign review_count = product.id | modulo: 2500 | plus: 843
  assign hero_summary = product.metafields.custom.pdp_summary.value | default: section.settings.default_summary
  assign hero_summary = hero_summary | replace: '[product]', product.title

  if hero_summary == blank
    assign hero_summary = product.description | strip_html | truncatewords: 28
  endif
  if hero_summary == blank
    assign hero_summary = product.title | append: ' is a clean, practitioner-grade supplement designed for focused daily support.'
  endif

  assign doctor_heading = product.metafields.custom.pdp_doctor_heading.value | default: section.settings.doctor_heading
  assign doctor_body = product.metafields.custom.pdp_doctor_body.value | default: section.settings.doctor_body
  assign doctor_body = doctor_body | replace: '[product]', product.title
  assign benefit_one = product.metafields.custom.pdp_benefit_1.value | default: section.settings.benefit_one
  assign benefit_two = product.metafields.custom.pdp_benefit_2.value | default: section.settings.benefit_two
  assign benefit_three = product.metafields.custom.pdp_benefit_3.value | default: section.settings.benefit_three
  assign facts_copy = product.metafields.custom.pdp_facts.value | default: section.settings.facts_copy
  assign shipping_copy = product.metafields.custom.pdp_shipping_returns.value | default: section.settings.shipping_copy
  assign subscription_price = current_variant.price | times: 90 | divided_by: 100
  assign why_heading = product.metafields.custom.pdp_why_heading.value | default: section.settings.why_heading | replace: '[product]', product.title
  assign why_intro = product.metafields.custom.pdp_why_intro.value | default: section.settings.why_intro | replace: '[product]', product.title
  assign ingredients_heading = product.metafields.custom.pdp_ingredients_heading.value | default: section.settings.ingredients_heading
  assign ingredients_intro = product.metafields.custom.pdp_ingredients_intro.value | default: section.settings.ingredients_intro
  assign product_lower = product.title | downcase

  assign first_selling_plan = blank
  for selling_plan_group in product.selling_plan_groups
    for selling_plan in selling_plan_group.selling_plans
      assign first_selling_plan = selling_plan
      break
    endfor
    if first_selling_plan != blank
      break
    endif
  endfor
%}

<section class="tmrx-pdp" data-product-section>
  <div class="tmrx-pdp__inner">
    <div class="tmrx-pdp__media-column">
      <div class="tmrx-pdp-gallery" data-pdp-gallery>
        <div class="tmrx-pdp-gallery__main">
          {% for slot in (1..5) %}
            {% liquid
              assign gallery_image = blank
              if product.images.size > 0
                assign image_index = slot | minus: 1 | modulo: product.images.size
                assign gallery_image = product.images[image_index]
              endif
              assign image_alt = product.title
              if gallery_image.alt != blank
                assign image_alt = gallery_image.alt
              endif
            %}
            <div class="tmrx-pdp-gallery__frame{% if slot == 1 %} is-active{% endif %}{% unless gallery_image %} tmrx-placeholder-media{% endunless %}" data-pdp-image="{{ slot }}">
              {% if section.settings.badge_label != blank and slot == 1 %}
                <span class="tmrx-pdp__badge">{{ section.settings.badge_label }}</span>
              {% endif %}
              {% if gallery_image %}
                {{ gallery_image | image_url: width: 1200 | image_tag: loading: 'eager', alt: image_alt }}
              {% endif %}
            </div>
          {% endfor %}
        </div>

        <div class="tmrx-pdp-gallery__thumbs" aria-label="Product images">
          {% for slot in (1..5) %}
            {% liquid
              assign thumb_image = blank
              if product.images.size > 0
                assign thumb_index = slot | minus: 1 | modulo: product.images.size
                assign thumb_image = product.images[thumb_index]
              endif
              assign thumb_alt = product.title
              if thumb_image.alt != blank
                assign thumb_alt = thumb_image.alt
              endif
            %}
            <button class="tmrx-pdp-gallery__thumb{% if slot == 1 %} is-active{% endif %}{% unless thumb_image %} tmrx-placeholder-media{% endunless %}" type="button" data-pdp-thumb="{{ slot }}" aria-label="View product image {{ slot }}">
              {% if thumb_image %}
                {{ thumb_image | image_url: width: 260 | image_tag: loading: 'lazy', alt: thumb_alt }}
              {% endif %}
            </button>
          {% endfor %}
        </div>
      </div>
    </div>

    <div class="tmrx-pdp__info-column">
      <nav class="tmrx-pdp-breadcrumbs" aria-label="Breadcrumb">
        <a href="{{ routes.all_products_collection_url }}">All</a>
        <span aria-hidden="true">/</span>
        <span>{{ product.title }}</span>
      </nav>

      <h1>{{ product.title }}</h1>

      <a class="tmrx-pdp-rating" href="#tmrx-pdp-details" aria-label="5 star rating based on {{ review_count }} reviews">
        <span aria-hidden="true">*****</span>
        <small>{{ review_count }} Reviews</small>
      </a>

      <p class="tmrx-pdp-summary">{{ hero_summary }}</p>

      <a class="tmrx-pdp-doctor-link" href="#tmrx-doctor-recommended">
        Doctor Recommended Formula
        <img src="{{ 'icon-arrow-right.svg' | asset_url }}" alt="" width="18" height="18" aria-hidden="true" loading="lazy">
      </a>

      <div class="tmrx-pdp-benefits" aria-label="Formula standards">
        <div class="tmrx-pdp-benefit">
          <span aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M5 12c4.8-8 10.2-8 14-8-1 6.6-4.2 13-12 13"/><path d="M5 20c2.3-4.6 6.1-7.5 11.5-8.8"/></svg>
          </span>
          {{ benefit_one }}
        </div>
        <div class="tmrx-pdp-benefit">
          <span aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M12 3 5 6v5c0 4.6 2.9 8.6 7 10 4.1-1.4 7-5.4 7-10V6l-7-3Z"/><path d="m9 12 2 2 4-5"/></svg>
          </span>
          {{ benefit_two }}
        </div>
        <div class="tmrx-pdp-benefit">
          <span aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M9 3h6M10 3v6l-4.2 7.3A3 3 0 0 0 8.4 21h7.2a3 3 0 0 0 2.6-4.7L14 9V3"/><path d="M8 16h8"/></svg>
          </span>
          {{ benefit_three }}
        </div>
      </div>

      {% form 'product', product, id: product_form_id, class: 'tmrx-pdp-form', data-product-form: '' %}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
        <input type="hidden" name="properties[Purchase Type]" value="Subscribe and Save" data-purchase-property>
        <input type="hidden" name="properties[Delivery Frequency]" value="30 days" data-frequency-property>

        {% unless product.has_only_default_variant %}
          <div class="tmrx-pdp-options">
            {% for option in product.options_with_values %}
              {% assign option_name = option.name | downcase %}
              <fieldset class="tmrx-pdp-option" data-product-option="{{ forloop.index0 }}">
                <legend>{{ option.name }}:</legend>
                {% if option_name contains 'flavor' %}
                  <button class="tmrx-pdp-select-row" type="button" data-option-trigger>
                    <span>{{ option.selected_value | default: option.values.first }}</span>
                    <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg>
                  </button>
                  <div class="tmrx-pdp-option__choices">
                    {% for value in option.values %}
                      <button class="{% if option.selected_value == value or forloop.first and option.selected_value == blank %}is-selected{% endif %}" type="button" data-option-value="{{ value | escape }}">
                        {{ value }}
                      </button>
                    {% endfor %}
                  </div>
                {% else %}
                  <div class="tmrx-pdp-option__buttons">
                    {% for value in option.values %}
                      <button class="{% if option.selected_value == value or forloop.first and option.selected_value == blank %}is-selected{% endif %}" type="button" data-option-value="{{ value | escape }}">
                        {{ value }}
                      </button>
                    {% endfor %}
                  </div>
                {% endif %}
              </fieldset>
            {% endfor %}
          </div>
        {% else %}
          <div class="tmrx-pdp-options tmrx-pdp-options--static">
            <div class="tmrx-pdp-option">
              <p>Size:</p>
              <div class="tmrx-pdp-single-size">
                <strong>One size available</strong>
                <span>This product is only available in one size. Select one-time purchase and adjust quantity at checkout for multiples.</span>
              </div>
            </div>
          </div>
        {% endunless %}

        <div class="tmrx-pdp-purchase">
          <p>Frequency:</p>
          <label class="tmrx-pdp-purchase-card is-selected" data-purchase-card>
            <input type="radio" name="purchase_option" value="subscription" checked data-purchase-option>
            <span class="tmrx-pdp-purchase-card__body">
              <span class="tmrx-pdp-purchase-card__header">
                <span><strong>Subscribe and Save</strong> <em>10%</em></span>
                <span class="tmrx-pdp-purchase-card__price">
                  <del data-regular-price>{{ current_variant.price | money }}</del>
                  <strong data-subscription-price>{{ subscription_price | money }}</strong>
                </span>
              </span>
              <span class="tmrx-pdp-free-shipping">Free Shipping</span>
              <span class="tmrx-pdp-purchase-card__details">
                <span>Save 10% on every order</span>
                <span>Free Shipping</span>
                <span>Cancel or pause anytime</span>
              </span>
              <select class="tmrx-pdp-frequency" {% if first_selling_plan != blank %}name="selling_plan"{% endif %} data-selling-plan-select>
                {% if first_selling_plan != blank %}
                  {% for selling_plan_group in product.selling_plan_groups %}
                    {% for selling_plan in selling_plan_group.selling_plans %}
                      <option value="{{ selling_plan.id }}">{{ selling_plan.name }}</option>
                    {% endfor %}
                  {% endfor %}
                {% else %}
                  <option value="30 days">30 days</option>
                  <option value="60 days">60 days</option>
                  <option value="90 days">90 days</option>
                {% endif %}
              </select>
            </span>
          </label>

          <label class="tmrx-pdp-one-time tmrx-pdp-purchase-card--simple" data-purchase-card>
            <input type="radio" name="purchase_option" value="one-time" data-purchase-option>
            <span class="tmrx-pdp-one-time__body">
              <span><strong>One-Time Purchase</strong></span>
              <strong data-one-time-price>{{ current_variant.price | money }}</strong>
            </span>
          </label>
        </div>

        {% if form.errors %}
          <div class="tmrx-pdp-form__errors" role="alert">{{ form.errors | default_errors }}</div>
        {% endif %}

        <button class="tmrx-pdp-add" type="submit" {% unless current_variant.available %}disabled{% endunless %} data-add-to-cart>
          {% if current_variant.available %}Add To Cart{% else %}Sold Out{% endif %}
        </button>

        <script type="application/json" data-product-json>
          {{ product | json }}
        </script>
      {% endform %}
    </div>
  </div>

  <div class="tmrx-pdp-sticky" data-pdp-sticky hidden>
    <div class="tmrx-pdp-sticky__inner">
      <div class="tmrx-pdp-sticky__product">
        <div class="tmrx-pdp-sticky__image{% if product.featured_image == blank %} tmrx-placeholder-media{% endif %}">
          {% if product.featured_image %}
            {{ product.featured_image | image_url: width: 170 | image_tag: loading: 'lazy', alt: product.title }}
          {% endif %}
        </div>
        <div>
          <h2>{{ product.title }}</h2>
          <a class="tmrx-pdp-rating tmrx-pdp-sticky__rating" href="#tmrx-pdp-details" aria-label="5 star rating based on {{ review_count }} reviews">
            <span aria-hidden="true">*****</span>
            <small>{{ review_count }} Reviews</small>
          </a>
          <p>
            <strong data-sticky-subscription-price>{{ subscription_price | money }}</strong>
            <del data-sticky-regular-price>{{ current_variant.price | money }}</del>
          </p>
        </div>
      </div>

      <div class="tmrx-pdp-sticky__summary" data-sticky-summary>
        <span data-sticky-summary-method>Subscribe and <em>Save 10%</em></span>
        <span data-sticky-summary-perk>+ Free Shipping</span>
      </div>

      <div class="tmrx-pdp-sticky__purchase" data-sticky-purchase-panel>
        <label>
          <input type="radio" name="sticky_purchase_option_{{ section.id }}" value="one-time" data-sticky-purchase-option>
          <span>One-Time Purchase</span>
        </label>
        <label>
          <input type="radio" name="sticky_purchase_option_{{ section.id }}" value="subscription" checked data-sticky-purchase-option>
          <span>Subscribe and <em>Save 10%</em></span>
        </label>
        <div class="tmrx-pdp-sticky__perks">
          <span><img src="{{ 'green-checkmark.svg' | asset_url }}" alt="" width="18" height="18" aria-hidden="true">Save 10% on every order</span>
          <span><img src="{{ 'green-checkmark.svg' | asset_url }}" alt="" width="18" height="18" aria-hidden="true">Free Shipping</span>
          <span><img src="{{ 'green-checkmark.svg' | asset_url }}" alt="" width="18" height="18" aria-hidden="true">Cancel or pause anytime</span>
        </div>
      </div>

      <div class="tmrx-pdp-sticky__actions">
        <button class="tmrx-pdp-sticky__edit" type="button" aria-expanded="false" data-sticky-edit>
          Edit
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
        </button>
        <select class="tmrx-pdp-sticky__frequency" data-sticky-frequency aria-label="Delivery frequency">
          {% if first_selling_plan != blank %}
            {% for selling_plan_group in product.selling_plan_groups %}
              {% for selling_plan in selling_plan_group.selling_plans %}
                <option value="{{ selling_plan.id }}">{{ selling_plan.name }}</option>
              {% endfor %}
            {% endfor %}
          {% else %}
            <option value="30 days">30 days</option>
            <option value="60 days">60 days</option>
            <option value="90 days">90 days</option>
          {% endif %}
        </select>
        <button class="tmrx-pdp-sticky__add" type="submit" form="{{ product_form_id }}" {% unless current_variant.available %}disabled{% endunless %} data-sticky-add-to-cart>
          {% if current_variant.available %}Add To Cart{% else %}Sold Out{% endif %}
        </button>
      </div>
    </div>
  </div>

  <div class="tmrx-pdp-details" id="tmrx-pdp-details">
    <div class="tmrx-pdp-doctor-card" id="tmrx-doctor-recommended">
      <div>
        <h2>{{ doctor_heading }}</h2>
        <p>{{ doctor_body }}</p>
      </div>
      <div class="tmrx-pdp-doctor-card__links">
        <a href="{{ routes.all_products_collection_url }}?tmrx_category=wellness">
          Shop practitioner-grade wellness support
          <img src="{{ 'icon-arrow-right.svg' | asset_url }}" alt="" width="18" height="18" aria-hidden="true" loading="lazy">
        </a>
        <a href="{{ routes.all_products_collection_url }}">
          View all clean formulas
          <img src="{{ 'icon-arrow-right.svg' | asset_url }}" alt="" width="18" height="18" aria-hidden="true" loading="lazy">
        </a>
      </div>
      <img class="tmrx-pdp-doctor-card__badge" src="{{ 'doctor-recommended-badge.png' | asset_url }}" alt="Doctor recommended" width="180" height="180" loading="lazy">
    </div>

    <div class="tmrx-pdp-accordions">
      <details class="tmrx-pdp-accordion">
        <summary>Description</summary>
        <div class="tmrx-pdp-accordion__body">
          {% if product.metafields.custom.pdp_description.value != blank %}
            <div class="rte">{{ product.metafields.custom.pdp_description | metafield_tag }}</div>
          {% elsif product.description != blank %}
            <div class="rte">{{ product.description }}</div>
          {% else %}
            <p>{{ product.title }} is formulated for clean daily support without unnecessary fillers, artificial colors, or artificial preservatives.</p>
          {% endif %}
        </div>
      </details>
      <details class="tmrx-pdp-accordion">
        <summary>Nutrition & Supplement Facts</summary>
        <div class="tmrx-pdp-accordion__body">
          <p>{{ facts_copy | replace: '[product]', product.title | newline_to_br }}</p>
        </div>
      </details>
      <details class="tmrx-pdp-accordion">
        <summary>Shipping & Returns</summary>
        <div class="tmrx-pdp-accordion__body">
          <p>{{ shipping_copy | newline_to_br }}</p>
        </div>
      </details>
    </div>
  </div>

  <div class="tmrx-pdp-use">
    <div class="tmrx-pdp-section-intro">
      <h2>{{ why_heading }}</h2>
      <p>{{ why_intro }}</p>
    </div>
    <div class="tmrx-pdp-use__grid">
      <article class="tmrx-pdp-use-card">
        <div>
          <h3>Support Daily Performance</h3>
          <p>Purposeful nutrition support for training days, busy schedules, and consistent routines.</p>
        </div>
        <div class="tmrx-pdp-use-card__media tmrx-placeholder-media" aria-hidden="true"></div>
      </article>
      <article class="tmrx-pdp-use-card">
        <div>
          <h3>Promote Recovery</h3>
          <p>Designed to help you stay steady between workouts and come back ready for the next session.</p>
        </div>
        <div class="tmrx-pdp-use-card__media tmrx-placeholder-media" aria-hidden="true"></div>
      </article>
      <article class="tmrx-pdp-use-card">
        <div>
          <h3>Fit a Clean Routine</h3>
          <p>Made for customers who want simple formulas without unnecessary fillers or artificial additives.</p>
        </div>
        <div class="tmrx-pdp-use-card__media tmrx-placeholder-media" aria-hidden="true"></div>
      </article>
      <article class="tmrx-pdp-use-card">
        <div>
          <h3>Support Long-Term Wellness</h3>
          <p>Built to pair with nutrition, hydration, movement, and practitioner-guided health goals.</p>
        </div>
        <div class="tmrx-pdp-use-card__media tmrx-placeholder-media" aria-hidden="true"></div>
      </article>
    </div>
  </div>

  <div class="tmrx-pdp-ingredients">
    <div class="tmrx-pdp-section-intro">
      <h2>{{ ingredients_heading }}</h2>
      <p>{{ ingredients_intro }}</p>
    </div>
    <div class="tmrx-pdp-ingredients__grid">
      {% if product_lower contains 'creatine hmb' %}
        {% render 'tmrx-ingredient-card', title: 'Creatine Monohydrate', amount: '5,000 mg', body: 'Supports cellular energy production by helping replenish ATP during high-intensity exercise.' %}
        {% render 'tmrx-ingredient-card', title: 'myHMB', amount: '1,500 mg', body: 'A leucine metabolite commonly used to support muscle recovery and help reduce muscle protein breakdown.' %}
        {% render 'tmrx-ingredient-card', title: 'Vitamin D3', amount: '12.5 mcg (500 IU)', body: 'A fat-soluble nutrient that supports muscle function, immune health, and bone health.' %}
        {% render 'tmrx-ingredient-card', title: 'BioPerine Black Pepper Extract', amount: '5 mg', body: 'A standardized black pepper extract included to support ingredient absorption.' %}
      {% elsif product.handle == 'true-creatine' %}
        {% render 'tmrx-ingredient-card', title: 'Micronized Creatine Monohydrate', amount: '5,000 mg', body: 'Supports ATP regeneration for strength, power output, and repeated high-intensity effort.' %}
      {% elsif product.handle == 'creatine-hcl' or product_lower contains 'creatine hcl' %}
        {% render 'tmrx-ingredient-card', title: 'Creatine HCl', amount: '1,500 mg', body: 'A highly soluble creatine form used to support strength, power output, and training performance.' %}
      {% elsif product.handle == 'bone-broth-protein' %}
        {% render 'tmrx-ingredient-card', title: 'Beef Bone Broth Protein', amount: '22g protein', body: 'Grass-fed beef bone broth protein to support daily protein intake and recovery routines.' %}
      {% elsif product.handle == 'true-omega' %}
        {% render 'tmrx-ingredient-card', title: 'Omega-3 Fatty Acids', amount: '4 soft gels', body: 'Supports cardiovascular, brain, joint, and general wellness routines.' %}
        {% render 'tmrx-ingredient-card', title: 'CoQ10 + Astaxanthin', amount: '', body: 'Pairs cellular energy support with antioxidant protection for daily vitality.' %}
      {% elsif product.handle == 'true-greens' %}
        {% render 'tmrx-ingredient-card', title: 'Supergreens Blend', amount: '1 serving', body: 'A greens-focused formula designed to help round out daily nutrition habits.' %}
        {% render 'tmrx-ingredient-card', title: 'Spirulina, Barley Grass, Beet + Matcha', amount: '', body: 'Plant-based nutrients selected for antioxidant, energy, and daily wellness support.' %}
      {% elsif product.handle == 'calm' %}
        {% render 'tmrx-ingredient-card', title: 'Magnesium Bisglycinate Chelate', amount: '1 capsule', body: 'A gentle, bioavailable magnesium form designed to support calm, rest, muscle, and nerve function.' %}
      {% elsif product.handle == 'vitamin-d-k2' %}
        {% render 'tmrx-ingredient-card', title: 'Vitamin D3', amount: '5,000 IU', body: 'Supports immune health, calcium utilization, mood, energy, and healthy bone maintenance.' %}
        {% render 'tmrx-ingredient-card', title: 'Vitamin K2', amount: '250 mcg', body: 'Pairs with vitamin D to support healthy calcium metabolism.' %}
      {% elsif product.handle == 'essential-aminos' %}
        {% render 'tmrx-ingredient-card', title: 'Essential Amino Acids', amount: '5g', body: 'Includes all nine EAAs to support muscle protein synthesis, recovery, and cellular repair.' %}
        {% render 'tmrx-ingredient-card', title: 'Magnesium Bisglycinate + L-Carnitine', amount: '', body: 'Supports neuromuscular function, hydration routines, and mitochondrial energy production.' %}
      {% elsif product.handle == 'secretropin' %}
        {% render 'tmrx-ingredient-card', title: 'Amino Acid Proprietary Blend', amount: '300 mg per 2 sprays', body: 'Includes pyroglutamine, glutamine, arginine, lysine, valine, tyrosine, ornithine, GABA, and related support nutrients.' %}
      {% elsif product.handle == 'n1o1-nitric-oxide-lozenges' %}
        {% render 'tmrx-ingredient-card', title: 'Nitric Oxide Lozenges', amount: '0.6 oz / 60 count', body: 'Designed as an easy daily lozenge format to support nitric-oxide and blood-flow routines.' %}
      {% else %}
        {% render 'tmrx-ingredient-card', title: 'Purposeful Active Ingredients', amount: '', body: 'Selected to match the product goal and support consistent daily use. Review the product label for the exact per-serving amount.' %}
      {% endif %}
    </div>
  </div>

  <div class="tmrx-pdp-stack">
    <div class="tmrx-pdp-stack__heading">
      <h2>Complete Your Stack</h2>
      <p>Pair {{ product.title }} with these products for a complete foundational stack.</p>
    </div>
    <div class="tmrx-pdp-stack__grid">
      {% liquid
        assign stack_recovery = all_products['true-creatine']
        if stack_recovery.handle == product.handle or stack_recovery == blank
          assign stack_recovery = all_products['creatine-hcl']
        endif
        if stack_recovery.handle == product.handle or stack_recovery == blank
          assign stack_recovery = all_products['essential-aminos']
        endif
      %}
      {% if stack_recovery != blank and stack_recovery.handle != product.handle %}
        {% render 'tmrx-stack-card', product: stack_recovery, category: 'Build Muscle & Recover' %}
      {% endif %}

      {% liquid
        assign stack_protein = all_products['bone-broth-protein']
        if stack_protein.handle == product.handle or stack_protein == blank
          assign stack_protein = all_products['essential-aminos']
        endif
        if stack_protein.handle == product.handle or stack_protein == blank
          assign stack_protein = all_products['true-greens']
        endif
      %}
      {% if stack_protein != blank and stack_protein.handle != product.handle %}
        {% render 'tmrx-stack-card', product: stack_protein, category: 'Protein' %}
      {% endif %}

      {% liquid
        assign stack_performance = all_products['n1o1-nitric-oxide-lozenges']
        if stack_performance.handle == product.handle or stack_performance == blank
          assign stack_performance = all_products['mito-revive']
        endif
        if stack_performance.handle == product.handle or stack_performance == blank
          assign stack_performance = all_products['true-creatine']
        endif
      %}
      {% if stack_performance != blank and stack_performance.handle != product.handle %}
        {% render 'tmrx-stack-card', product: stack_performance, category: 'Improve Performance' %}
      {% endif %}

      {% liquid
        assign stack_wellness = all_products['true-omega']
        if stack_wellness.handle == product.handle or stack_wellness == blank
          assign stack_wellness = all_products['true-greens']
        endif
        if stack_wellness.handle == product.handle or stack_wellness == blank
          assign stack_wellness = all_products['calm']
        endif
        if stack_wellness.handle == product.handle or stack_wellness == blank
          assign stack_wellness = all_products['vitamin-d-k2']
        endif
      %}
      {% if stack_wellness != blank and stack_wellness.handle != product.handle %}
        {% render 'tmrx-stack-card', product: stack_wellness, category: 'Health & Wellness' %}
      {% endif %}
    </div>
  </div>
</section>

