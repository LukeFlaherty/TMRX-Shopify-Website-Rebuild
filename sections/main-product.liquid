        <button class="tmrx-pdp-sticky__add" type="submit" form="{{ product_form_id }}" {% unless current_variant.available %}disabled{% endunless %} data-sticky-add-to-cart>
          {% if current_variant.available %}Add To Cart{% else %}Sold Out{% endif %}
