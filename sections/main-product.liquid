        {% render 'tmrx-ingredient-card', title: 'Spirulina, Barley Grass, Beet + Matcha', amount: '', body: 'Plant-based nutrients selected for antioxidant, energy, and daily wellness support.' %}
      {% elsif product.handle == 'calm' %}
