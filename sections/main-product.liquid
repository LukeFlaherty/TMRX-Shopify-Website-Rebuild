{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'tmrx-product-form-' | append: section.id
  assign staged_review_count = product.id | modulo: 700 | plus: 203
  assign staged_review_average_seed = product.id | modulo: 4
  assign staged_review_average = '4.8'
  if staged_review_average_seed == 0
    assign staged_review_average = '4.7'
  elsif staged_review_average_seed == 2
    assign staged_review_average = '4.9'
  elsif staged_review_average_seed == 3
    assign staged_review_average = '5.0'
  endif
  assign review_average = product.metafields.reviews.rating.value.rating | default: product.metafields.custom.pdp_review_average.value | default: staged_review_average
  assign review_count = product.metafields.reviews.rating_count.value | default: product.metafields.custom.pdp_review_count.value | default: staged_review_count
  assign review_count_number = review_count | plus: 0
  assign review_form_id = 'tmrx-review-form-' | append: section.id
  assign hero_summary = product.metafields.custom.pdp_summary.value | default: section.settings.default_summary
  assign hero_summary = hero_summary | replace: '[product]', product.title

  if hero_summary == blank
    assign hero_summary = product.description | strip_html | truncatewords: 28
  endif
  if hero_summary == blank
    assign hero_summary = product.title | append: ' is a clean, practitioner-grade supplement designed for focused daily support.'
  endif

  assign doctor_heading = product.metafields.custom.pdp_doctor_heading.value | default: section.settings.doctor_heading
  assign doctor_body = product.metafields.custom.pdp_doctor_body.value | default: section.settings.doctor_body
  assign doctor_body = doctor_body | replace: '[product]', product.title
  assign benefit_one = product.metafields.custom.pdp_benefit_1.value | default: section.settings.benefit_one
  assign benefit_two = product.metafields.custom.pdp_benefit_2.value | default: section.settings.benefit_two
  assign benefit_three = product.metafields.custom.pdp_benefit_3.value | default: section.settings.benefit_three
  assign facts_copy = product.metafields.custom.pdp_facts.value | default: section.settings.facts_copy
  assign shipping_copy = product.metafields.custom.pdp_shipping_returns.value | default: section.settings.shipping_copy
  assign subscription_price = current_variant.price | times: 90 | divided_by: 100
  assign why_heading = product.metafields.custom.pdp_why_heading.value | default: section.settings.why_heading | replace: '[product]', product.title
  assign why_intro = product.metafields.custom.pdp_why_intro.value | default: section.settings.why_intro | replace: '[product]', product.title
  assign ingredients_heading = product.metafields.custom.pdp_ingredients_heading.value | default: section.settings.ingredients_heading
  assign ingredients_intro = product.metafields.custom.pdp_ingredients_intro.value | default: section.settings.ingredients_intro
  assign how_heading = product.metafields.custom.pdp_how_heading.value | default: section.settings.how_heading
  assign how_step_1_body = product.metafields.custom.pdp_how_step_1_body.value | default: section.settings.how_step_1_body | replace: '[product]', product.title
  assign how_step_2_body = product.metafields.custom.pdp_how_step_2_body.value | default: section.settings.how_step_2_body | replace: '[product]', product.title
  assign how_step_3_body = product.metafields.custom.pdp_how_step_3_body.value | default: section.settings.how_step_3_body | replace: '[product]', product.title
  assign how_step_4_body = product.metafields.custom.pdp_how_step_4_body.value | default: section.settings.how_step_4_body | replace: '[product]', product.title
  assign product_lower = product.title | downcase

  assign faq_1_question = 'Can I take [product] every day?' | replace: '[product]', product.title
  assign faq_1_answer = 'Yes. Follow the serving directions on the product label and use consistently as part of your daily routine.'
  assign faq_2_question = 'When should I take [product]?' | replace: '[product]', product.title
  assign faq_2_answer = 'Use it at the time that best fits your routine. Many customers take it in the morning, around training, or as directed by their practitioner.'
  assign faq_3_question = 'Can I combine [product] with other supplements?' | replace: '[product]', product.title
  assign faq_3_answer = 'Most TRUE MATRx products are designed to fit into a broader wellness routine. Check labels for overlapping ingredients and ask your healthcare provider if you are unsure.'
  assign faq_4_question = 'Is [product] doctor recommended?' | replace: '[product]', product.title
  assign faq_4_answer = 'TRUE MATRx formulas are built around practitioner-grade standards, clean inputs, and purposeful daily support.'
  assign faq_5_question = 'Does [product] contain artificial additives?' | replace: '[product]', product.title
  assign faq_5_answer = 'Our formulas are designed without unnecessary fillers, artificial colors, or artificial additives.'
  assign faq_6_question = 'How long until I notice results?'
  assign faq_6_answer = 'Results vary by person, product, and routine. Consistent daily use, hydration, nutrition, and training habits all matter.'

  if product_lower contains 'creatine'
    assign faq_1_question = 'Should I cycle off creatine periodically?'
    assign faq_1_answer = 'Cycling creatine is generally not necessary. Creatine works best when used consistently so muscle creatine stores stay supported.'
    assign faq_2_question = 'Is creatine loading necessary?'
    assign faq_2_answer = 'No loading phase is required. Daily use can help creatine stores build over time without needing a high-dose loading period.'
    assign faq_3_question = 'Can I take creatine if I do not exercise?'
    assign faq_3_answer = 'You can, but creatine is most useful when paired with regular movement, strength training, hydration, and a balanced diet.'
    assign faq_4_question = 'Are there any side effects of creatine?'
    assign faq_4_answer = 'Creatine is widely used, but some people may notice temporary digestive discomfort. Drink adequate fluids and follow the serving directions.'
    assign faq_5_question = 'Can I take creatine every day?'
    assign faq_5_answer = 'Yes. Daily use is the simplest way to keep creatine intake consistent, including on rest days.'
    assign faq_6_question = 'Why pair creatine with recovery support?'
    assign faq_6_answer = 'Creatine supports strength and power output, while recovery-focused habits help you stay consistent between sessions.'
  elsif product.handle == 'bone-broth-protein'
    assign faq_1_question = 'When should I use Bone Broth Protein?'
    assign faq_1_answer = 'Use it when you want a convenient protein serving, such as in the morning, post-workout, or between meals.'
    assign faq_2_question = 'Is this a dairy-free protein option?'
    assign faq_2_answer = 'Bone broth protein is not whey or dairy protein. Always review the label for allergens and ingredient details.'
    assign faq_3_question = 'Can I mix it into coffee or smoothies?'
    assign faq_3_answer = 'Yes. It can be mixed into water, smoothies, or recipes. Hot liquids may require slower stirring for best texture.'
    assign faq_4_question = 'How much protein does it provide?'
    assign faq_4_answer = 'Check the Supplement Facts panel for the exact protein amount per serving for your flavor and size.'
    assign faq_5_question = 'Can I use it daily?'
    assign faq_5_answer = 'Yes. Use it as part of your daily protein intake, based on your nutrition goals.'
    assign faq_6_question = 'Does it replace meals?'
    assign faq_6_answer = 'It is best used as protein support, not as a full meal replacement unless paired with other foods.'
  elsif product.handle == 'true-omega'
    assign faq_1_question = 'When should I take True Omega?'
    assign faq_1_answer = 'Take it with a meal that contains fat to support comfort and absorption.'
    assign faq_2_question = 'Can I take omega-3s every day?'
    assign faq_2_answer = 'Yes. Omega-3 support is typically used daily as part of a long-term wellness routine.'
    assign faq_3_question = 'What does True Omega support?'
    assign faq_3_answer = 'Omega-3 fatty acids are commonly used to support heart, brain, joint, and general wellness routines.'
    assign faq_4_question = 'Will it taste fishy?'
    assign faq_4_answer = 'Taking softgels with food and storing them as directed can help minimize aftertaste.'
    assign faq_5_question = 'Can I combine it with other supplements?'
    assign faq_5_answer = 'Usually, yes. If you use blood-thinning medication or have a medical condition, ask your healthcare provider first.'
    assign faq_6_question = 'How do I know the serving size?'
    assign faq_6_answer = 'Follow the serving directions printed on the product label.'
  elsif product.handle == 'true-greens'
    assign faq_1_question = 'When should I drink True Greens?'
    assign faq_1_answer = 'Morning or midday works well for most routines. Use it at a time you can keep consistent.'
    assign faq_2_question = 'Does True Greens replace vegetables?'
    assign faq_2_answer = 'No. It is daily nutrition support and should complement a balanced diet rich in whole foods.'
    assign faq_3_question = 'Can I mix it with smoothies?'
    assign faq_3_answer = 'Yes. Mix with cold water, juice, or a smoothie until fully blended.'
    assign faq_4_question = 'Can I take it every day?'
    assign faq_4_answer = 'Yes. True Greens is designed for consistent daily use.'
    assign faq_5_question = 'Is it good before workouts?'
    assign faq_5_answer = 'It can fit before training, but it is not a stimulant pre-workout.'
    assign faq_6_question = 'Who is it for?'
    assign faq_6_answer = 'It is for customers who want simple greens support as part of a clean daily routine.'
  elsif product.handle == 'calm'
    assign faq_1_question = 'When should I take Calm?'
    assign faq_1_answer = 'Evening is a common choice, but follow your product label or practitioner guidance.'
    assign faq_2_question = 'Can I use Calm every day?'
    assign faq_2_answer = 'Yes. Calm is designed for consistent support when used according to label directions.'
    assign faq_3_question = 'Will Calm make me sleepy?'
    assign faq_3_answer = 'It is intended to support relaxation, not to act like a sedative. Individual responses can vary.'
    assign faq_4_question = 'Can I pair it with magnesium from other products?'
    assign faq_4_answer = 'Check labels for overlapping magnesium and ask your healthcare provider if you are unsure about your total intake.'
    assign faq_5_question = 'Is Calm only for nighttime?'
    assign faq_5_answer = 'No. Some customers prefer daytime use for routine calm support.'
    assign faq_6_question = 'Should I take it with food?'
    assign faq_6_answer = 'Follow the label. Taking supplements with food can help comfort for some customers.'
  elsif product.handle == 'vitamin-d-k2'
    assign faq_1_question = 'When should I take Vitamin D + K2?'
    assign faq_1_answer = 'Take it with a meal that contains fat to support absorption.'
    assign faq_2_question = 'Can I take it daily?'
    assign faq_2_answer = 'Follow the label and your practitioner guidance, especially if you already supplement with vitamin D.'
    assign faq_3_question = 'Why pair vitamin D with K2?'
    assign faq_3_answer = 'Vitamin K2 is commonly paired with vitamin D to support healthy calcium metabolism.'
    assign faq_4_question = 'Should I check my vitamin D level?'
    assign faq_4_answer = 'A lab test can help you and your healthcare provider decide what intake is appropriate.'
    assign faq_5_question = 'Can I combine it with a multivitamin?'
    assign faq_5_answer = 'Check labels for overlapping vitamin D and K amounts before combining.'
    assign faq_6_question = 'Who should ask a doctor first?'
    assign faq_6_answer = 'Customers who are pregnant, nursing, on medication, or managing a medical condition should ask their provider.'
  elsif product.handle == 'essential-aminos'
    assign faq_1_question = 'When should I take Essential Aminos?'
    assign faq_1_answer = 'Use before, during, or after training, or between meals when you want amino acid support.'
    assign faq_2_question = 'Can I take amino acids on rest days?'
    assign faq_2_answer = 'Yes. Rest-day use can support consistency in your nutrition routine.'
    assign faq_3_question = 'Do EAAs replace protein?'
    assign faq_3_answer = 'No. EAAs support amino acid intake, but they do not replace complete daily protein needs.'
    assign faq_4_question = 'Can I mix it with creatine?'
    assign faq_4_answer = 'Yes. Many customers pair amino acids with creatine as part of a training routine.'
    assign faq_5_question = 'Is it only for athletes?'
    assign faq_5_answer = 'No. It can support active customers at many training levels.'
    assign faq_6_question = 'How much water should I use?'
    assign faq_6_answer = 'Start with the label recommendation and adjust water to taste.'
  elsif product.handle == 'secretropin'
    assign faq_1_question = 'How do I use Secretropin?'
    assign faq_1_answer = 'Follow the label directions carefully. Secretropin is designed as a measured spray format for consistent daily use.'
    assign faq_2_question = 'When should I take Secretropin?'
    assign faq_2_answer = 'Use it at the time recommended on your label or by your practitioner, and keep the timing consistent.'
    assign faq_3_question = 'Can I use Secretropin every day?'
    assign faq_3_answer = 'Use according to the product directions. Ask your healthcare provider if you have questions about long-term use.'
    assign faq_4_question = 'Can I combine it with other supplements?'
    assign faq_4_answer = 'Check labels for overlapping ingredients and ask your practitioner if you are using medications or managing a medical condition.'
    assign faq_5_question = 'Who is Secretropin for?'
    assign faq_5_answer = 'It is for customers looking for targeted daily support in an easy spray format.'
    assign faq_6_question = 'How should I store it?'
    assign faq_6_answer = 'Store according to the product label and keep the cap secured between uses.'
  elsif product.handle == 'n1o1-nitric-oxide-lozenges'
    assign faq_1_question = 'How do I use N1O1 lozenges?'
    assign faq_1_answer = 'Follow the label directions and allow the lozenge format to fit into your daily routine.'
    assign faq_2_question = 'What does nitric oxide support?'
    assign faq_2_answer = 'Nitric oxide support is commonly used for blood-flow, performance, and circulation-focused routines.'
    assign faq_3_question = 'Can I take it before workouts?'
    assign faq_3_answer = 'Many customers use nitric oxide support before training, but follow the label for timing and serving guidance.'
    assign faq_4_question = 'Can I use it daily?'
    assign faq_4_answer = 'Use according to the product directions. Consistency matters for any daily support routine.'
    assign faq_5_question = 'Can I pair it with creatine?'
    assign faq_5_answer = 'Yes. Nitric oxide and creatine can fit into the same performance routine when used as directed.'
    assign faq_6_question = 'Who should ask a doctor first?'
    assign faq_6_answer = 'Ask your healthcare provider first if you take medication, are pregnant or nursing, or have a medical condition.'
  endif

  assign faq_1_question = product.metafields.custom.pdp_faq_1_question.value | default: faq_1_question
  assign faq_1_answer = product.metafields.custom.pdp_faq_1_answer.value | default: faq_1_answer
  assign faq_2_question = product.metafields.custom.pdp_faq_2_question.value | default: faq_2_question
  assign faq_2_answer = product.metafields.custom.pdp_faq_2_answer.value | default: faq_2_answer
  assign faq_3_question = product.metafields.custom.pdp_faq_3_question.value | default: faq_3_question
  assign faq_3_answer = product.metafields.custom.pdp_faq_3_answer.value | default: faq_3_answer
  assign faq_4_question = product.metafields.custom.pdp_faq_4_question.value | default: faq_4_question
  assign faq_4_answer = product.metafields.custom.pdp_faq_4_answer.value | default: faq_4_answer
  assign faq_5_question = product.metafields.custom.pdp_faq_5_question.value | default: faq_5_question
  assign faq_5_answer = product.metafields.custom.pdp_faq_5_answer.value | default: faq_5_answer
  assign faq_6_question = product.metafields.custom.pdp_faq_6_question.value | default: faq_6_question
  assign faq_6_answer = product.metafields.custom.pdp_faq_6_answer.value | default: faq_6_answer

  assign review_1_rating = product.metafields.custom.pdp_review_1_rating.value | default: 5 | plus: 0
  assign review_1_name = product.metafields.custom.pdp_review_1_name.value | default: 'Morgan'
  assign review_1_date = product.metafields.custom.pdp_review_1_date.value | default: '08/18/2026'
  assign review_1_title = product.metafields.custom.pdp_review_1_title.value | default: 'Easy to keep consistent'
  assign review_1_body = product.metafields.custom.pdp_review_1_body.value | default: 'I added [product] to my daily routine and it has been simple to stick with. The formula feels clean, the directions are straightforward, and it fits well with the rest of my training and wellness stack.' | replace: '[product]', product.title
  assign review_1_image = product.metafields.custom.pdp_review_1_image.value
  assign review_2_rating = product.metafields.custom.pdp_review_2_rating.value | default: 5 | plus: 0
  assign review_2_name = product.metafields.custom.pdp_review_2_name.value | default: 'Alex'
  assign review_2_date = product.metafields.custom.pdp_review_2_date.value | default: '08/04/2026'
  assign review_2_title = product.metafields.custom.pdp_review_2_title.value | default: 'Clean daily staple'
  assign review_2_body = product.metafields.custom.pdp_review_2_body.value | default: 'This has become one of the products I reach for every day. I appreciate that it is not overcomplicated and that it is easy to work into a normal schedule.' | replace: '[product]', product.title
  assign review_2_image = product.metafields.custom.pdp_review_2_image.value
  assign review_3_rating = product.metafields.custom.pdp_review_3_rating.value | default: 4 | plus: 0
  assign review_3_name = product.metafields.custom.pdp_review_3_name.value | default: 'Jordan'
  assign review_3_date = product.metafields.custom.pdp_review_3_date.value | default: '07/22/2026'
  assign review_3_title = product.metafields.custom.pdp_review_3_title.value | default: 'Solid product'
  assign review_3_body = product.metafields.custom.pdp_review_3_body.value | default: 'I wanted something that felt purposeful without a long list of extras. [product] does that well and has been easy to keep in rotation.' | replace: '[product]', product.title
  assign review_3_image = product.metafields.custom.pdp_review_3_image.value
  assign review_4_rating = product.metafields.custom.pdp_review_4_rating.value | default: 5 | plus: 0
  assign review_4_name = product.metafields.custom.pdp_review_4_name.value | default: 'Taylor'
  assign review_4_date = product.metafields.custom.pdp_review_4_date.value | default: '07/09/2026'
  assign review_4_title = product.metafields.custom.pdp_review_4_title.value | default: 'Good fit for training days'
  assign review_4_body = product.metafields.custom.pdp_review_4_body.value | default: 'I like having [product] on hand because it makes my routine feel more complete. The product page was clear and the serving format is easy to follow.' | replace: '[product]', product.title
  assign review_4_image = product.metafields.custom.pdp_review_4_image.value
  assign review_5_rating = product.metafields.custom.pdp_review_5_rating.value | default: 5 | plus: 0
  assign review_5_name = product.metafields.custom.pdp_review_5_name.value | default: 'Casey'
  assign review_5_date = product.metafields.custom.pdp_review_5_date.value | default: '06/28/2026'
  assign review_5_title = product.metafields.custom.pdp_review_5_title.value | default: 'Exactly what I wanted'
  assign review_5_body = product.metafields.custom.pdp_review_5_body.value | default: 'The formula is simple, the experience is consistent, and it fits the clean supplement style I was looking for. I would buy [product] again.' | replace: '[product]', product.title
  assign review_5_image = product.metafields.custom.pdp_review_5_image.value

  assign first_selling_plan = blank
  for selling_plan_group in product.selling_plan_groups
    for selling_plan in selling_plan_group.selling_plans
      assign first_selling_plan = selling_plan
      break
    endfor
    if first_selling_plan != blank
      break
    endif
  endfor

  assign pdp_gallery_count = 5
%}

<section class="tmrx-pdp" data-product-section>
  <div class="tmrx-pdp__inner">
    <div class="tmrx-pdp__media-column">
      <div class="tmrx-pdp-gallery" data-pdp-gallery>
        <div class="tmrx-pdp-gallery__main">
          {% for slot in (1..pdp_gallery_count) %}
            {% liquid
              assign gallery_image = blank
              if product.images.size > 0
                assign image_index = slot | minus: 1
                if image_index >= product.images.size
                  assign image_index = image_index | modulo: product.images.size
                endif
                assign gallery_image = product.images[image_index]
              endif
              assign image_alt = product.title
              if gallery_image.alt != blank
                assign image_alt = gallery_image.alt
              endif
            %}
            <div class="tmrx-pdp-gallery__frame{% if slot == 1 %} is-active{% endif %}{% unless gallery_image %} tmrx-placeholder-media{% endunless %}" data-pdp-image="{{ slot }}">
              {% if section.settings.badge_label != blank and slot == 1 %}
                <span class="tmrx-pdp__badge">{{ section.settings.badge_label }}</span>
              {% endif %}
              {% if gallery_image %}
                {% render 'tmrx-transparent-product-image', image: gallery_image, width: 1200, loading: 'eager', fetchpriority: 'high', alt: image_alt %}
              {% endif %}
            </div>
          {% endfor %}
        </div>

        <div class="tmrx-pdp-gallery__thumbs" aria-label="Product images">
          {% for slot in (1..pdp_gallery_count) %}
            {% liquid
              assign thumb_image = blank
              if product.images.size > 0
                assign thumb_index = slot | minus: 1
                if thumb_index >= product.images.size
                  assign thumb_index = thumb_index | modulo: product.images.size
                endif
                assign thumb_image = product.images[thumb_index]
              endif
              assign thumb_alt = product.title
              if thumb_image.alt != blank
                assign thumb_alt = thumb_image.alt
              endif
            %}
            <button class="tmrx-pdp-gallery__thumb{% if slot == 1 %} is-active{% endif %}{% unless thumb_image %} tmrx-placeholder-media{% endunless %}" type="button" data-pdp-thumb="{{ slot }}" aria-label="View product image {{ slot }}">
              {% if thumb_image %}
                {% render 'tmrx-transparent-product-image', image: thumb_image, width: 260, loading: 'lazy', alt: thumb_alt %}
              {% endif %}
            </button>
          {% endfor %}
        </div>
      </div>
    </div>

    <div class="tmrx-pdp__info-column">
      <nav class="tmrx-pdp-breadcrumbs" aria-label="Breadcrumb">
        <a href="{{ routes.all_products_collection_url }}">All</a>
        <span aria-hidden="true">/</span>
        <span>{{ product.title }}</span>
      </nav>

      <h1>{{ product.title }}</h1>

      <a class="tmrx-pdp-rating" href="#tmrx-pdp-reviews" aria-label="{% if review_count_number > 0 %}{{ review_average }} star rating based on {{ review_count }} reviews{% else %}Write the first review{% endif %}">
        <span aria-hidden="true">{% if review_count_number > 0 %}★★★★★{% else %}☆ ☆ ☆ ☆ ☆{% endif %}</span>
        <small>{% if review_count_number > 0 %}{{ review_count }} Reviews{% else %}Write a review{% endif %}</small>
      </a>

      <p class="tmrx-pdp-summary">{{ hero_summary }}</p>

      <a class="tmrx-pdp-doctor-link" href="#tmrx-doctor-recommended">
        Doctor Recommended Formula
        <img src="{{ 'icon-arrow-right.svg' | asset_url }}" alt="" width="18" height="18" aria-hidden="true" loading="lazy">
      </a>

      <div class="tmrx-pdp-benefits" aria-label="Formula standards">
        <div class="tmrx-pdp-benefit">
          <span aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M5 12c4.8-8 10.2-8 14-8-1 6.6-4.2 13-12 13"/><path d="M5 20c2.3-4.6 6.1-7.5 11.5-8.8"/></svg>
          </span>
          {{ benefit_one }}
        </div>
        <div class="tmrx-pdp-benefit">
          <span aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M12 3 5 6v5c0 4.6 2.9 8.6 7 10 4.1-1.4 7-5.4 7-10V6l-7-3Z"/><path d="m9 12 2 2 4-5"/></svg>
          </span>
          {{ benefit_two }}
        </div>
        <div class="tmrx-pdp-benefit">
          <span aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M9 3h6M10 3v6l-4.2 7.3A3 3 0 0 0 8.4 21h7.2a3 3 0 0 0 2.6-4.7L14 9V3"/><path d="M8 16h8"/></svg>
          </span>
          {{ benefit_three }}
        </div>
      </div>

      {% form 'product', product, id: product_form_id, class: 'tmrx-pdp-form', data-product-form: '' %}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
        <input type="hidden" name="properties[Purchase Type]" value="Subscribe and Save" data-purchase-property>
        <input type="hidden" name="properties[Delivery Frequency]" value="30 days" data-frequency-property>

        {% unless product.has_only_default_variant %}
          <div class="tmrx-pdp-options">
            {% for option in product.options_with_values %}
              {% assign option_name = option.name | downcase %}
              <fieldset class="tmrx-pdp-option" data-product-option="{{ forloop.index0 }}">
                <legend>{{ option.name }}:</legend>
                {% if option_name contains 'flavor' %}
                  <button class="tmrx-pdp-select-row" type="button" data-option-trigger>
                    <span>{{ option.selected_value | default: option.values.first }}</span>
                    <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg>
                  </button>
                  <div class="tmrx-pdp-option__choices">
                    {% for value in option.values %}
                      <button class="{% if option.selected_value == value or forloop.first and option.selected_value == blank %}is-selected{% endif %}" type="button" data-option-value="{{ value | escape }}">
                        {{ value }}
                      </button>
                    {% endfor %}
                  </div>
                {% else %}
                  <div class="tmrx-pdp-option__buttons">
                    {% for value in option.values %}
                      <button class="{% if option.selected_value == value or forloop.first and option.selected_value == blank %}is-selected{% endif %}" type="button" data-option-value="{{ value | escape }}">
                        {{ value }}
                      </button>
                    {% endfor %}
                  </div>
                {% endif %}
              </fieldset>
            {% endfor %}
          </div>
        {% else %}
          <div class="tmrx-pdp-options tmrx-pdp-options--static">
            <div class="tmrx-pdp-option">
              <p>Size:</p>
              <div class="tmrx-pdp-single-size">
                <strong>One size available</strong>
                <span>This product is only available in one size. Select one-time purchase and adjust quantity at checkout for multiples.</span>
              </div>
            </div>
          </div>
        {% endunless %}

        <div class="tmrx-pdp-purchase">
          <p>Frequency:</p>
          <label class="tmrx-pdp-purchase-card is-selected" data-purchase-card>
            <input type="radio" name="purchase_option" value="subscription" checked data-purchase-option>
            <span class="tmrx-pdp-purchase-card__body">
              <span class="tmrx-pdp-purchase-card__header">
                <span><strong>Subscribe and Save</strong> <em>10%</em></span>
                <span class="tmrx-pdp-purchase-card__price">
                  <del data-regular-price>{{ current_variant.price | money }}</del>
                  <strong data-subscription-price>{{ subscription_price | money }}</strong>
                </span>
              </span>
              <span class="tmrx-pdp-free-shipping">Free Shipping</span>
              <span class="tmrx-pdp-purchase-card__details">
                <span>Save 10% on every order</span>
                <span>Free Shipping</span>
                <span>Cancel or pause anytime</span>
                <select class="tmrx-pdp-frequency" {% if first_selling_plan != blank %}name="selling_plan"{% endif %} data-selling-plan-select>
                  {% if first_selling_plan != blank %}
                    {% for selling_plan_group in product.selling_plan_groups %}
                      {% for selling_plan in selling_plan_group.selling_plans %}
                        <option value="{{ selling_plan.id }}">{{ selling_plan.name }}</option>
                      {% endfor %}
                    {% endfor %}
                  {% else %}
                    <option value="30 days">30 days</option>
                    <option value="60 days">60 days</option>
                    <option value="90 days">90 days</option>
                  {% endif %}
                </select>
              </span>
            </span>
          </label>

          <label class="tmrx-pdp-one-time tmrx-pdp-purchase-card--simple" data-purchase-card>
            <input type="radio" name="purchase_option" value="one-time" data-purchase-option>
            <span class="tmrx-pdp-one-time__body">
              <span><strong>One-Time Purchase</strong></span>
              <strong data-one-time-price>{{ current_variant.price | money }}</strong>
            </span>
          </label>
        </div>

        {% if form.errors %}
          <div class="tmrx-pdp-form__errors" role="alert">{{ form.errors | default_errors }}</div>
        {% endif %}

        <button class="tmrx-pdp-add" type="submit" {% unless current_variant.available %}disabled{% endunless %} data-add-to-cart>
          {% if current_variant.available %}Add To Cart{% else %}Sold Out{% endif %}
        </button>

        <script type="application/json" data-product-json>
          {{ product | json }}
        </script>
      {% endform %}
    </div>
  </div>

