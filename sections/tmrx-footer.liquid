<footer class="tmrx-footer">
  <div class="tmrx-footer__inner">
    <div class="tmrx-footer__nav" aria-label="Footer navigation">
      <details class="tmrx-footer__group" open>
        <summary>Company</summary>
        <ul>
          <li><a href="{% if shop.shipping_policy.url != blank %}{{ shop.shipping_policy.url }}{% else %}/policies/shipping-policy{% endif %}">Shipping Info</a></li>
          <li><a href="{% if shop.privacy_policy.url != blank %}{{ shop.privacy_policy.url }}{% else %}/policies/privacy-policy{% endif %}">Privacy Policy</a></li>
          <li><a href="{% if shop.terms_of_service.url != blank %}{{ shop.terms_of_service.url }}{% else %}/policies/terms-of-service{% endif %}">Terms and Conditions</a></li>
          <li><a href="{{ routes.all_products_collection_url }}">Subscribe & Save</a></li>
          <li><a href="mailto:{{ section.settings.support_email }}?subject=Wholesale%20Inquiry">Wholesale</a></li>
          <li><a href="mailto:{{ section.settings.support_email }}">Contact Us</a></li>
        </ul>
      </details>

      <details class="tmrx-footer__group" open>
        <summary>Links</summary>
        <ul>
          <li><a href="{{ routes.all_products_collection_url }}">All Products</a></li>
          <li><a href="{{ routes.all_products_collection_url }}?tmrx_category=recovery">Build Muscle & Recover</a></li>
          <li><a href="{{ routes.all_products_collection_url }}?tmrx_category=protein">Protein</a></li>
          <li><a href="{{ routes.all_products_collection_url }}?tmrx_category=wellness">Health & Wellness</a></li>
          <li><a href="{% if shop.refund_policy.url != blank %}{{ shop.refund_policy.url }}{% else %}/policies/refund-policy{% endif %}">Refund Policy</a></li>
          <li><a href="/blogs/news">Blog</a></li>
        </ul>
      </details>

      <details class="tmrx-footer__group" open>
        <summary>Resources</summary>
        <ul>
          <li><a href="{{ routes.all_products_collection_url }}?tmrx_category=bestsellers">Bestsellers</a></li>
          <li><a href="{{ routes.all_products_collection_url }}?tmrx_category=pre-workout">Pre-Workout</a></li>
          <li><a href="{{ routes.all_products_collection_url }}?tmrx_category=weight-loss">Weight Loss</a></li>
          <li><a href="{{ routes.search_url }}">Search</a></li>
        </ul>
      </details>
    </div>

    <div class="tmrx-footer__newsletter">
      <h2>Newsletter</h2>
      <p>{{ section.settings.newsletter_copy }}</p>

      {% form 'customer', class: 'tmrx-footer__form', data-klaviyo-footer-newsletter: '' %}
        <input type="hidden" name="contact[tags]" value="newsletter,footer">
        <input type="hidden" name="contact[accepts_marketing]" value="true">
        <div class="tmrx-footer__fields">
          <label class="visually-hidden" for="FooterNewsletterFirstName-{{ section.id }}">First Name</label>
          <input id="FooterNewsletterFirstName-{{ section.id }}" type="text" name="contact[first_name]" autocomplete="given-name" placeholder="First Name">

          <label class="visually-hidden" for="FooterNewsletterEmail-{{ section.id }}">Email Address</label>
          <input id="FooterNewsletterEmail-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" autocorrect="off" autocapitalize="off" placeholder="Email Address" required>
        </div>
        <button type="submit">Sign Up</button>

        {% if form.posted_successfully? %}
          <p class="tmrx-footer__form-message" role="status">Thanks for signing up.</p>
        {% elsif form.errors %}
          <div class="tmrx-footer__form-message" role="alert">{{ form.errors | default_errors }}</div>
        {% endif %}
      {% endform %}
    </div>

    <div class="tmrx-footer__bottom">
      <div class="tmrx-footer__social" aria-label="Social links">
        {% if section.settings.instagram_url != blank %}
          <a href="{{ section.settings.instagram_url }}" aria-label="Instagram">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17" cy="7" r="1"/></svg>
          </a>
        {% endif %}
        {% if section.settings.facebook_url != blank %}
          <a href="{{ section.settings.facebook_url }}" aria-label="Facebook">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 8h3V4h-3c-3 0-5 2-5 5v3H6v4h3v5h4v-5h3l1-4h-4V9c0-.6.4-1 1-1Z"/></svg>
          </a>
        {% endif %}
        {% if section.settings.tiktok_url != blank %}
          <a href="{{ section.settings.tiktok_url }}" aria-label="TikTok">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 4c.5 2.8 2.2 4.7 5 5v4c-1.9 0-3.6-.6-5-1.7V16a5 5 0 1 1-5-5c.4 0 .7 0 1 .1v4.2a1.6 1.6 0 1 0 0 1.4V4h4Z"/></svg>
          </a>
        {% endif %}
      </div>

      <div class="tmrx-footer__contact">
        <a href="mailto:{{ section.settings.support_email }}">{{ section.settings.support_email }}</a>
        <p>{{ section.settings.address }}</p>
      </div>

      <p class="tmrx-footer__disclaimer">{{ section.settings.disclaimer }}</p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "textarea",
      "id": "newsletter_copy",
      "label": "Newsletter copy",
      "default": "Sign up to get the latest on sales, new releases and more."
    },
    {
      "type": "text",
      "id": "support_email",
      "label": "Support email",
      "default": "support@truematrx.com"
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "Footer address",
      "default": "Shipping and Returns: TRUE MATRx, United States"
    },
    {
      "type": "textarea",
      "id": "disclaimer",
      "label": "Disclaimer",
      "default": "Statements regarding supplement benefits have not been evaluated by the Food and Drug Administration. TRUE MATRx products are not intended to diagnose, treat, cure, or prevent any disease."
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok URL"
    }
  ]
}
{% endschema %}
