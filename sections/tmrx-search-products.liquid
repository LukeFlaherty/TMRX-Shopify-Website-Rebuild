<section class="tmrx-search-products" data-search-products>
  <div class="tmrx-search-products__inner">
    <nav class="tmrx-breadcrumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span aria-hidden="true">/</span>
      <span>{{ section.settings.heading }}</span>
    </nav>

    <header class="tmrx-search-products__header">
      <div class="tmrx-search-products__copy">
        <h1>{{ section.settings.heading }}</h1>
        {% if section.settings.text != blank %}
          <p>{{ section.settings.text }}</p>
        {% endif %}
      </div>

      <form class="tmrx-search-products__form" action="{{ routes.search_url }}" role="search" data-search-products-form>
        <label for="SearchProductsInput-{{ section.id }}">Search products</label>
        <div class="tmrx-search-products__field">
          <svg aria-hidden="true" viewBox="0 0 24 24">
            <path d="m21 21-4.3-4.3M10.8 18a7.2 7.2 0 1 1 0-14.4 7.2 7.2 0 0 1 0 14.4Z" />
          </svg>
          <input
            id="SearchProductsInput-{{ section.id }}"
            type="search"
            name="q"
            value="{{ search.terms | escape }}"
            placeholder="{{ section.settings.placeholder }}"
            autocomplete="off"
            autocorrect="off"
            spellcheck="false"
            data-search-products-input
          >
          <button type="button" data-search-products-clear hidden>Clear</button>
        </div>
      </form>
    </header>

    {% paginate collections.all.products by 250 %}
      {% if collections.all.products_count > 0 %}
        <div class="tmrx-search-products__bar">
          <p data-search-products-status aria-live="polite">
            <span data-search-products-prefix>Showing</span>
            <span data-search-products-count>{{ collections.all.products_count }}</span>
            <span data-search-products-suffix>products</span>
          </p>
        </div>

        <div class="tmrx-collection-grid tmrx-search-products__grid">
          {% for product in collections.all.products %}
            {% liquid
              assign product_tags = product.tags | join: ' '
              assign product_search_text = product.title
              assign product_search_text = product_search_text | append: ' ' | append: product.vendor
              assign product_search_text = product_search_text | append: ' ' | append: product.type
              assign product_search_text = product_search_text | append: ' ' | append: product_tags
              assign product_search_text = product_search_text | append: ' ' | append: product.description | strip_html
            %}

            <div
              class="tmrx-collection-product"
              data-search-product
              data-search-product-text="{{ product_search_text | downcase | escape }}"
            >
              {% render 'tmrx-supplement-card', product: product, badge: section.settings.badge_label, index: forloop.index %}
            </div>
          {% endfor %}
        </div>

        <div class="tmrx-collection-empty tmrx-search-products__empty" data-search-products-empty hidden>
          <h2>No matching products</h2>
          <p>Try a product name, ingredient, category, or health goal.</p>
        </div>
      {% else %}
        <div class="tmrx-collection-empty">
          <h2>No products found</h2>
          <p>Add products to the shop to make them searchable here.</p>
        </div>
      {% endif %}
    {% endpaginate %}
  </div>
</section>

{% schema %}
{
  "name": "Product search",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Search Products"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Browse every TRUE MATRx formula, then narrow the grid instantly by typing a product name, ingredient, category, or goal."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Search placeholder",
      "default": "Search by product, ingredient, or goal"
    },
    {
      "type": "text",
      "id": "badge_label",
      "label": "Badge label",
      "default": "Best Seller"
    }
  ]
}
{% endschema %}
