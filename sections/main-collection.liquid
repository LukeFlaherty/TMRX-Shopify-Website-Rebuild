{% liquid
  assign collection_title = collection.title
  assign collection_description = collection.description | strip_html

  if collection.handle == 'all'
    assign collection_title = 'Shop All Supplements'
    if collection_description == blank
      assign collection_description = 'Explore TRUE MATRx full range of clean, practitioner-grade supplements.'
    endif
  elsif collection_description == blank
    assign collection_description = 'Shop clean, practitioner-grade supplements built for focused health and performance goals.'
  endif

  assign collection_base_url = routes.all_products_collection_url
%}

<section class="tmrx-collection-page">
  <div class="tmrx-collection-page__inner">
    <nav class="tmrx-breadcrumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span aria-hidden="true">/</span>
      <span>{{ collection_title }}</span>
    </nav>

    <header class="tmrx-collection-hero">
      <h1 data-collection-title>{{ collection_title }}</h1>
      <p data-collection-description>{{ collection_description }}</p>

      <div class="tmrx-collection-pills" aria-label="Shop categories">
        <a class="is-active" href="{{ collection_base_url }}" data-collection-pill="all">All Products</a>
        <a href="{{ collection_base_url }}?tmrx_category=bestsellers" data-collection-pill="bestsellers">Bestsellers</a>
        <a href="{{ collection_base_url }}?tmrx_category=protein" data-collection-pill="protein">Protein</a>
        <a href="{{ collection_base_url }}?tmrx_category=recovery" data-collection-pill="recovery">Build Muscle & Recover</a>
        <a href="{{ collection_base_url }}?tmrx_category=pre-workout" data-collection-pill="pre-workout">Pre-Workout</a>
        <a href="{{ collection_base_url }}?tmrx_category=wellness" data-collection-pill="wellness">Health & Wellness</a>
        <a href="{{ collection_base_url }}?tmrx_category=weight-loss" data-collection-pill="weight-loss">Weight Loss</a>
      </div>
    </header>

    <div class="tmrx-collection-layout">
      <div class="tmrx-collection-results">
        {% paginate collection.products by section.settings.products_per_page %}
          {% if collection.products_count > 0 %}
            <div class="tmrx-collection-grid">
              {% for product in collection.products %}
                {% liquid
                  assign product_categories = 'all'
                  assign product_text = product.title | append: ' ' | append: product.type | append: ' ' | append: product.tags | downcase

                  if forloop.index <= 4 or product_text contains 'best seller' or product_text contains 'bestseller'
                    assign product_categories = product_categories | append: ' bestsellers'
                  endif
                  if product_text contains 'protein' or product_text contains 'whey' or product_text contains 'collagen' or product_text contains 'bone broth' or product_text contains 'mass gainer' or product_text contains 'vegan'
                    assign product_categories = product_categories | append: ' protein'
                  endif
                  if product_text contains 'creatine' or product_text contains 'recovery' or product_text contains 'calm' or product_text contains 'magnesium' or product_text contains 'growth' or product_text contains 'bcaa' or product_text contains 'glutamine' or product_text contains 'hmb'
                    assign product_categories = product_categories | append: ' recovery'
                  endif
                  if product_text contains 'pre' or product_text contains 'workout' or product_text contains 'energy' or product_text contains 'performance' or product_text contains 'pump'
                    assign product_categories = product_categories | append: ' pre-workout'
                  endif
                  if product_text contains 'health' or product_text contains 'wellness' or product_text contains 'calm' or product_text contains 'magnesium' or product_text contains 'collagen' or product_text contains 'vitamin' or product_text contains 'greens'
                    assign product_categories = product_categories | append: ' wellness'
                  endif
                  if product_text contains 'weight' or product_text contains 'fat' or product_text contains 'lean' or product_text contains 'metabolism'
                    assign product_categories = product_categories | append: ' weight-loss'
                  endif
                %}
                <div class="tmrx-collection-product" data-collection-product="{{ product_categories | strip }}">
                  {% render 'tmrx-supplement-card', product: product, badge: section.settings.badge_label, index: forloop.index %}
                </div>
              {% endfor %}
            </div>
            <div class="tmrx-collection-empty tmrx-collection-empty--filtered" data-collection-empty hidden>
              <h2>No products found</h2>
              <p>Try another category or view all products.</p>
            </div>
          {% else %}
            <div class="tmrx-collection-empty">
              <h2>No products found</h2>
              <p>Try another category or view all products.</p>
            </div>
          {% endif %}

          {% if paginate.pages > 1 %}
            <nav class="tmrx-pagination" aria-label="Pagination">
              {{ paginate | default_pagination }}
            </nav>
          {% endif %}
        {% endpaginate %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 6,
      "max": 24,
      "step": 3,
      "default": 12
    },
    {
      "type": "text",
      "id": "badge_label",
      "label": "Badge label",
      "default": "Best Seller"
    }
  ]
}
{% endschema %}
